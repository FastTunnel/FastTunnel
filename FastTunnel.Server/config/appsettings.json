{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      //{
      //  "Name": "File",
      //  "Args": {
      //    "path": "Logs/log-.log",
      //    "rollingInterval": 3
      //  }
      //}
    ]
  },
  "AllowedHosts": "*",
  // 是否启用文件日志输出
  "EnableFileLog": false,
  "FastTunnel": {
    // 服务监听端口
    "BinPort": 1270,

    // 可选，绑定的根域名，
    // 客户端需配置SubDomain，实现 ${SubDomain}.${WebDomain}访问内网的站点，注意：需要通过域名访问网站时必选。
    "WebDomain": "test.cc",

    // 可选，访问白名单，为空时：所有人有权限访问，不为空时：不在白名单的ip拒绝。
    "WebAllowAccessIps": [ "192.168.0.101" ],

    // 可选，是否开启端口转发代理，禁用后不处理Forward类型端口转发.默认false。
    "EnableForward": true,

    // 可选，是否启用多路复用，默认true。
    // 启用后客户端只额外建立一条长连接，所有转发（HTTP/TCP/UDP）都在该连接上开流，
    // 不再为每条公网连接新建一条 TCP。客户端不支持时自动回退到旧模式。
    "EnableMux": true,

    // 客户端通道 TLS（默认开启）。公网用户访问内网站点仍是明文 HTTP，互不影响：
    // 同一端口按首字节分流，TLS 握手（0x16）走加密链路，其余照旧进 HTTP 管道。
    "Tls": {
      // 是否允许客户端用 TLS 接入。关闭后客户端只能配 Protocol=ws（明文）。
      "Enabled": true,
      // 证书文件（pfx/pem）。留空则用自动生成的自签证书。
      "CertFile": "",
      "CertPassword": "",
      // 未配置证书时自动生成自签证书并持久化到 config/ft-server.pfx。
      // 首次启动后请把日志里的 SHA-256 指纹配到客户端 CertificateFingerprint。
      "AutoGenerate": true
    },

    // 可选，当不为空时，客户端也必须携带Tokens中的任意一个token，否则拒绝登录。
    "Tokens": [ "TOKEN_FOR_CLIENT_AUTHENTICATION" ],

    /**
    * 访问api接口的JWT配置
    */
    "Api": {
      "JWT": {
        "ClockSkew": 10,
        "ValidAudience": "https://suidao.io",
        "ValidIssuer": "FastTunnel",
        "IssuerSigningKey": "This is IssuerSigningKey",
        "Expires": 120
      },
      "Accounts": [
        {
          "Name": "admin",
          "Password": "admin123"
        }
      ]
    }
  }
}
