{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      //{
      //  "Name": "File",
      //  "Args": {
      //    "path": "Logs/log-.log",
      //    "rollingInterval": 3
      //  }
      //}
    ]
  },
  "AllowedHosts": "*",
  // 是否启用文件日志输出
  "EnableFileLog": false,
  "FastTunnel": {
    // 服务监听端口（双栈：IPv4 与 IPv6 同时可达）
    "BinPort": 1270,

    // 可选，绑定的根域名，
    // 客户端需配置SubDomain，实现 ${SubDomain}.${WebDomain}访问内网的站点，注意：需要通过域名访问网站时必选。
    "WebDomain": "test.cc",

    // 可选，自定义域名黑名单。支持精确域名（"bad.example.com"）和后缀（".example.com" 含子域）。
    // 命中后拒绝登记该域名的 Web 映射；为空时不限制。
    "WebDomainBlacklist": [],

    // 可选，是否开启端口转发代理。默认 false：裸 TCP/UDP 转发不经过 HTTP 解析层，
    // 既拿不到真实访客来源、也无法做内容审计，是不可审计出口。确需使用时才显式改为 true，
    // 并为每个 RemotePort 放行防火墙 / 容器端口映射。
    // 开启后每个 RemotePort 都是双栈监听：IPv4 / IPv6 客户端都能连入；
    // 系统禁用 IPv6（部分容器）时自动退回纯 IPv4，无需改配置。
    "EnableForward": false,

    // 访问来源 IP 白名单，只作用于公网访客的 HTTP 请求（不作用于隧道客户端控制面 / API）。
    // 支持单个 IP 与 CIDR（如 "192.168.0.0/24"、"2001:db8::/32"）。为空时不限制。
    "WebAllowAccessIps": [],

    // 可信反向代理 IP / CIDR。只有来自这些地址的 TCP 连接才会采信 X-Forwarded-For、
    // Forwarded、X-Real-IP；其它来源一律以 TCP 对端 IP 为准，防止访客伪造头部绕过白名单。
    // 外挂 nginx 做 TLS 终止时填写 nginx 的回源地址；不在本机须改成实际回源网段。
    // 切勿填 "0.0.0.0/0"：那等于信任访客自带的 XFF。
    "TrustedProxyIps": [ "127.0.0.1", "::1" ],

    // 可选，是否启用多路复用，默认true。
    // 启用后客户端只额外建立一条长连接，所有转发（HTTP/TCP/UDP）都在该连接上开流，
    // 不再为每条公网连接新建一条 TCP。客户端不支持时自动回退到旧模式。
    "EnableMux": true,

    // 客户端通道 TLS（默认开启）。公网用户访问内网站点仍是明文 HTTP，互不影响：
    // 同一端口按首字节分流，TLS 握手（0x16）走加密链路，其余照旧进 HTTP 管道。
    "Tls": {
      // 是否允许客户端用 TLS 接入。关闭后客户端只能配 Protocol=ws（明文）。
      "Enabled": true,
      // 证书文件（pfx/pem）。留空则用自动生成的自签证书。
      "CertFile": "",
      "CertPassword": "",
      // 未配置证书时自动生成自签证书并持久化到 config/ft-server.pfx。
      // 首次启动后请把日志里的 SHA-256 指纹配到客户端 CertificateFingerprint。
      "AutoGenerate": true
    },

    // 旧版共享凭据（不推荐）：所有客户端共用一个 token，封禁无法定位到人。
    // 为空且未配置 Clients 时不校验 token；生产环境请改用下面的一户一 token。
    "Tokens": [ "TOKEN_FOR_CLIENT_AUTHENTICATION" ],

    /**
    * 一户一 token（推荐）。每个主体一条独立凭据、一个稳定 Id：
    * 封禁 / 审计 / 带宽统计都按 Id 归属，按 token 封禁不再误伤其它会话。
    * Id 与 Token 必须唯一；重复或非法条目会被跳过，并在 /healthz 的 credentials.warnings 里报出。
    *   Id             主体标识（账号 / 租户），封禁类型 "account" 用的就是它
    *   Token          该主体专用凭据，客户端填在 FastTunnel:Token
    *   SubDomain      可选，限定该主体只能使用这个子域（单个标签，不含根域名）
    *   AllowedHosts   可选，域名白名单；非空时子域与自定义域名都必须命中。
    *                  支持精确域名与 ".example.com"（含子域）两种写法
    *   BandwidthLimit 可选，该主体速率上限（字节/秒）；不填继承全局，0 表示显式不限速
    *   Enabled        可选，false 可停用一个主体而不删配置
    * 示例：{ "Id": "alice", "Token": "UNIQUE_TOKEN_FOR_ALICE", "SubDomain": "alice",
    *        "AllowedHosts": [ "alice.test.cc", ".example.com" ], "BandwidthLimit": 1048576 }
    * 只要配置了该段（哪怕条目全被停用）就强制要求 token，不会悄悄退回无鉴权模式。
    */
    "Clients": [],

    // 同一主体只允许一个在线会话：新登录会顶掉旧会话，防止一条凭据被多处同时使用。
    // 旧版共享 Tokens 不参与此判定（它本来就无法区分主体）。
    "EnforceSingleSession": true,

    /**
    * 带宽限速（单位字节/秒，0 = 不限速）。生效优先级：
    *   Bandwidth.PerProxy[域名 或 port:<RemotePort>] > Bandwidth.PerClient[主体 Id]
    *   > Clients[].BandwidthLimit > Bandwidth.DefaultBytesPerSecond
    * 令牌桶按「代理 + 方向」共享，允许 BurstSeconds 秒突发；连接关闭会立即中断限速等待。
    * 覆盖四条数据面：HTTP 回连 / HTTP mux / TCP 转发回连 / TCP 转发 mux，UDP 走双向流统计。
    */
    "Bandwidth": {
      "DefaultBytesPerSecond": 0,
      "BurstSeconds": 1,
      "PerProxy": {},
      "PerClient": {}
    },

    /**
    * 运维端点：GET /healthz（JSON 概览）、GET /metrics（Prometheus 0.0.4 文本）、
    * GET /api/Ops/Traffic（JWT，按代理流量明细）。
    * PublicEndpoints 默认 true 便于探活 / 抓取；生产建议在网关层限制来源 IP，
    * 或设为 false 要求 JWT。IncludeClientLabels=false 可让 /metrics 不输出主体 Id。
    * 探活请用服务端自身地址与端口：请求 Host 若命中已映射域名，会被转发到内网。
    */
    "Ops": {
      "PublicEndpoints": true,
      "IncludeClientLabels": true
    },

    /**
    * 违规管控（熔断与留证）。封禁记录持久化到 StateFile，进程重启后仍生效；
    * token 类主体只保存 SHA-256 指纹，文件里不会出现明文凭据。
    * Audit 为 JSONL 追加日志；留存不少于六个月需由部署层的日志轮转 / 归档保证。
    * 多实例部署请把这两个路径指向共享存储，当前实现是单机内存 + 本地文件。
    */
    "Abuse": {
      "Ban": {
        "StateFile": "config/bans.json"
      },
      "Audit": {
        "FilePath": "config/audit.jsonl",
        "MemoryCapacity": 10000
      }
    },

    /**
    * 访问api接口的JWT配置
    */
    "Api": {
      "JWT": {
        "ClockSkew": 10,
        "ValidAudience": "https://suidao.io",
        "ValidIssuer": "FastTunnel",
        "IssuerSigningKey": "This is IssuerSigningKey",
        "Expires": 120
      },
      "Accounts": [
        {
          "Name": "admin",
          "Password": "admin123"
        }
      ]
    }
  }
}
