<Project>
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/FastTunnel/FastTunnel</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Runtime Async V2：由运行时接管异步挂起/恢复，去掉编译器生成的状态机。
         A/B 实测：代码体积 -33%，分配回落到 net10 水平；.NET 11 BCL 已用此模式编译，
         应用侧保持关闭会导致两套异步模型混用（分配最差），故全解决方案统一开启。 -->
    <Features>runtime-async=on</Features>
    <Version>3.6.1</Version>
    <Copyright>FastTunnel</Copyright>
    <Description>expose a local server behind a NAT or firewall to the internet like ngrok and frp</Description>
    <Authors>Gui.H</Authors>
    <Company>FastTunnel</Company>
    <Product>FastTunnel</Product>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/FastTunnel/FastTunnel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>内网穿透;Proxy;TCP;HTTP;NAT;Tunnel</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Common defaults mirrored from several projects; adjust if needed -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
</Project>
